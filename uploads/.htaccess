# =============================================================================
# Folder berkas unggahan (gambar dari dashboard admin).
#
# Isinya memang harus bisa diakses publik, tetapi TIDAK BOLEH dieksekusi.
# Blok di bawah memastikan berkas apa pun yang berhasil masuk ke sini
# diperlakukan sebagai data biasa, bukan skrip.
# =============================================================================

# Matikan eksekusi PHP & CGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .shtml

Options -ExecCGI -Indexes

# Tolak akses ke berkas apa pun selain gambar
<FilesMatch "\.(?!(jpe?g|png|webp|gif|svg|ico|avif)$)[^.]*$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cache panjang - nama berkas sudah mengandung string acak, jadi aman
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</IfModule>
