<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Dekorasi.me — Sedang Dalam Pengembangan</title>
<meta name="description" content="Dekorasi.me — jasa desain interior. Website kami sedang dalam tahap pengembangan." />
<meta name="theme-color" content="#0c0c0e" />
<link rel="icon" href="assets/logo.png" type="image/png" />

<!-- Open Graph (untuk share ke WhatsApp / sosial media) -->
<meta property="og:type" content="website" />
<meta property="og:title" content="Dekorasi.me — Segera Hadir" />
<meta property="og:description" content="Website desain interior Dekorasi.me sedang dalam pengembangan." />
<meta property="og:image" content="assets/logo.png" />

<style>
  :root{
    --bg:        #0c0c0e;
    --bg-soft:   #141317;
    --gold:      #d9a441;
    --gold-lite: #f3d48a;
    --gold-deep: #8a5f1e;
    --text:      #ece9e4;
    --muted:     #9a958d;
    --line:      rgba(217,164,65,.16);
  }

  *{ box-sizing:border-box; margin:0; padding:0; }

  html{
    -webkit-text-size-adjust:100%;
    -webkit-tap-highlight-color:transparent;
  }

  body{
    min-height:100vh;
    min-height:100dvh; /* ikut tinggi asli saat address bar HP muncul/hilang */
    display:flex;
    flex-direction:column;
    align-items:center;
    /* Sengaja flex-start + margin auto pada .wrap/footer: kalau konten lebih
       tinggi dari layar, bagian atas tidak ikut terpotong seperti pada center. */
    justify-content:flex-start;
    gap:0;
    padding:40px 24px;
    background:var(--bg);
    color:var(--text);
    font-family:"Segoe UI",Inter,-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;
    text-align:center;
    overflow-x:hidden;
    position:relative;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
  }

  /* ---------- Latar: grid blueprint + cahaya hangat ---------- */
  .bg-grid,
  .bg-glow{ position:fixed; inset:0; pointer-events:none; z-index:0; }

  .bg-grid{
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:72px 72px;
    mask-image:radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 78%);
    -webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 78%);
    opacity:.55;
  }

  .bg-glow{
    background:
      radial-gradient(circle 480px at 50% 22%, rgba(217,164,65,.14), transparent 70%),
      radial-gradient(circle 640px at 85% 95%, rgba(138,95,30,.12), transparent 70%),
      radial-gradient(circle 520px at 8% 82%,  rgba(217,164,65,.07), transparent 70%);
  }

  .wrap{
    position:relative;
    z-index:1;
    width:100%;
    max-width:720px;
    margin-top:auto;
    display:flex;
    flex-direction:column;
    align-items:center;
    animation:rise .9s cubic-bezier(.2,.7,.3,1) both;
  }

  @keyframes rise{
    from{ opacity:0; transform:translateY(18px); }
    to  { opacity:1; transform:none; }
  }

  /* ---------- Logo ---------- */
  .logo{
    width:clamp(150px, 22vh, 220px);
    height:auto;
    filter:drop-shadow(0 14px 40px rgba(217,164,65,.28));
    animation:float 6s ease-in-out infinite;
  }

  @keyframes float{
    0%,100%{ transform:translateY(0); }
    50%    { transform:translateY(-10px); }
  }

  /* ---------- Badge status ---------- */
  .badge{
    margin-top:28px;
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:8px 18px;
    border:1px solid var(--line);
    border-radius:999px;
    background:rgba(217,164,65,.06);
    font-size:12px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--gold-lite);
  }

  .dot{
    width:7px; height:7px;
    border-radius:50%;
    background:var(--gold);
    box-shadow:0 0 0 0 rgba(217,164,65,.6);
    animation:pulse 2s infinite;
  }

  @keyframes pulse{
    0%  { box-shadow:0 0 0 0 rgba(217,164,65,.55); }
    70% { box-shadow:0 0 0 10px rgba(217,164,65,0); }
    100%{ box-shadow:0 0 0 0 rgba(217,164,65,0); }
  }

  /* ---------- Judul ---------- */
  h1{
    margin-top:22px;
    font-size:clamp(30px, 6.4vw, 54px);
    font-weight:700;
    line-height:1.12;
    letter-spacing:.01em;
    background:linear-gradient(120deg, var(--gold-lite) 8%, var(--gold) 42%, #fff2d2 62%, var(--gold-deep) 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  .lead{
    margin-top:18px;
    max-width:520px;
    font-size:clamp(15px, 2.1vw, 17px);
    line-height:1.75;
    color:var(--muted);
  }

  .lead strong{ color:var(--text); font-weight:600; }

  /* ---------- Progress ---------- */
  .progress{
    margin-top:36px;
    width:min(430px, 100%);
  }

  .progress-head{
    display:flex;
    justify-content:space-between;
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--muted);
    margin-bottom:10px;
  }

  .progress-head span:last-child{ color:var(--gold); font-weight:600; }

  .track{
    height:5px;
    border-radius:999px;
    background:rgba(255,255,255,.07);
    overflow:hidden;
  }

  .fill{
    height:100%;
    width:0;
    border-radius:999px;
    background:linear-gradient(90deg, var(--gold-deep), var(--gold), var(--gold-lite));
    box-shadow:0 0 14px rgba(217,164,65,.55);
    animation:load 2s cubic-bezier(.2,.8,.25,1) .5s forwards;
  }

  /* Ubah angka ini (dan teks 65% di atas) sesuai progres pengerjaan */
  @keyframes load{ to{ width:65%; } }

  /* ---------- Layanan ---------- */
  .tags{
    margin-top:38px;
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:10px;
  }

  .tag{
    padding:9px 16px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:10px;
    background:var(--bg-soft);
    font-size:13px;
    color:var(--muted);
    transition:border-color .25s, color .25s, transform .25s;
  }

  .tag:hover{
    border-color:var(--line);
    color:var(--gold-lite);
    transform:translateY(-2px);
  }

  /* ---------- Kontak ---------- */
  .actions{
    margin-top:40px;
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:12px;
  }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:13px 24px;
    border-radius:12px;
    font-size:14px;
    font-weight:600;
    text-decoration:none;
    transition:transform .22s, box-shadow .22s, background .22s, border-color .22s;
  }

  .btn svg{ width:17px; height:17px; }

  .btn-primary{
    background:linear-gradient(135deg, var(--gold) 0%, var(--gold-deep) 100%);
    color:#1a1206;
    box-shadow:0 10px 26px rgba(217,164,65,.22);
  }

  .btn-primary:hover{
    transform:translateY(-2px);
    box-shadow:0 14px 32px rgba(217,164,65,.34);
  }

  .btn-ghost{
    border:1px solid rgba(255,255,255,.12);
    color:var(--text);
    background:rgba(255,255,255,.02);
  }

  .btn-ghost:hover{
    transform:translateY(-2px);
    border-color:var(--line);
    background:rgba(217,164,65,.07);
  }

  /* ---------- Footer ---------- */
  footer{
    position:relative;
    z-index:1;
    margin-top:48px;
    margin-bottom:auto;
    padding-top:8px;
    font-size:12px;
    letter-spacing:.06em;
    color:#6d6862;
  }

  footer .sep{ margin:0 8px; opacity:.5; }

  /* Layar pendek (laptop / jendela browser tidak fullscreen):
     rapatkan jarak supaya logo & tombol tetap masuk tanpa scroll. */
  @media (min-width:641px) and (max-height:880px){
    body{ padding:26px 24px; }
    .badge   { margin-top:18px; }
    h1       { margin-top:14px; font-size:clamp(26px, 5vw, 42px); }
    .lead    { margin-top:12px; line-height:1.65; }
    .progress{ margin-top:22px; }
    .tags    { margin-top:22px; }
    .actions { margin-top:24px; }
    footer   { margin-top:28px; }
    .logo    { animation-name:none; }
  }

  /* ================= TABLET ================= */
  @media (max-width:640px){
    .bg-grid{ background-size:56px 56px; opacity:.45; }
    .lead{ max-width:44ch; }
    .tags{ gap:8px; }
  }

  /* ================= HANDPHONE ================= */
  @media (max-width:520px){
    body{
      padding:
        calc(28px + env(safe-area-inset-top)) 22px
        calc(24px + env(safe-area-inset-bottom));
    }

    .bg-grid{ background-size:44px 44px; opacity:.38; }

    .bg-glow{
      background:
        radial-gradient(circle 300px at 50% 16%, rgba(217,164,65,.16), transparent 72%),
        radial-gradient(circle 340px at 90% 92%, rgba(138,95,30,.13), transparent 72%);
    }

    .logo{
      width:min(168px, 46vw);
      filter:drop-shadow(0 10px 26px rgba(217,164,65,.24));
    }

    .badge{
      margin-top:20px;
      padding:7px 15px;
      font-size:10px;
      letter-spacing:.14em;
    }

    h1{
      margin-top:16px;
      font-size:clamp(26px, 8vw, 34px);
      line-height:1.2;
      letter-spacing:-.01em;
    }

    .lead{
      margin-top:14px;
      max-width:34ch;
      font-size:14.5px;
      line-height:1.7;
    }

    .progress{ margin-top:28px; width:100%; max-width:320px; }
    .progress-head{ font-size:10px; letter-spacing:.14em; }

    /* Chip layanan jadi grid 2 kolom — lebih rapi daripada wrap acak */
    .tags{
      margin-top:26px;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      width:100%;
      max-width:320px;
    }

    .tag{
      padding:11px 8px;
      font-size:12px;
      border-radius:12px;
      background:linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.012));
    }

    .actions{
      margin-top:28px;
      flex-direction:column;
      gap:10px;
      width:100%;
      max-width:320px;
    }

    .btn{
      justify-content:center;
      width:100%;
      padding:15px 20px;
      font-size:14.5px;
      border-radius:14px;
    }

    footer{ margin-top:34px; font-size:11px; }
  }

  /* Layar sangat kecil (iPhone SE dsb.) */
  @media (max-width:360px){
    body{ padding-left:18px; padding-right:18px; }
    .logo{ width:148px; }
    h1{ font-size:24px; }
    .lead{ font-size:13.5px; }
    .tags{ grid-template-columns:1fr; max-width:280px; }
    .actions,.progress{ max-width:280px; }
  }

  /* HP diputar mendatar */
  @media (max-width:900px) and (max-height:480px){
    body{ padding:22px; }
    .logo{ width:104px; animation-name:none; }
    .badge{ margin-top:12px; }
    h1{ margin-top:10px; font-size:24px; }
    .lead{ margin-top:10px; font-size:13.5px; max-width:52ch; }
    .progress{ margin-top:16px; }
    .tags{ margin-top:16px; display:flex; max-width:none; }
    .actions{ margin-top:18px; flex-direction:row; max-width:none; }
    .btn{ width:auto; padding:12px 20px; }
    footer{ margin-top:22px; }
  }

  /* Efek hover hanya untuk perangkat ber-mouse, supaya di HP tidak
     ada state hover yang "nyangkut" setelah disentuh. */
  @media (hover:none){
    .tag:hover,
    .btn:hover{ transform:none; }
    .btn-primary:active{ transform:scale(.98); }
    .btn-ghost:active{ transform:scale(.98); background:rgba(217,164,65,.09); }
  }

  @media (prefers-reduced-motion:reduce){
    *{ animation:none !important; transition:none !important; }
    .fill{ width:65%; }
  }
</style>
</head>
<body>

<div class="bg-glow"></div>
<div class="bg-grid"></div>

<main class="wrap">

  <img class="logo" src="assets/logo.png" alt="Dekorasi.me" />

  <div class="badge"><span class="dot"></span> Under Development</div>

  <h1>Website Sedang<br />Dalam Pengembangan</h1>

  <p class="lead">
    Kami sedang menyiapkan ruang digital untuk <strong>Dekorasi.me</strong> —
    tempat Anda menemukan inspirasi dan layanan desain interior.
    Terima kasih sudah mampir, sebentar lagi kami hadir.
  </p>

  <div class="progress">
    <div class="progress-head">
      <span>Progres Pembangunan</span>
      <span>65%</span>
    </div>
    <div class="track"><div class="fill"></div></div>
  </div>

  <div class="tags">
    <div class="tag">Desain Interior</div>
    <div class="tag">Visualisasi 3D</div>
    <div class="tag">Furniture Custom</div>
    <div class="tag">Konsultasi Ruang</div>
  </div>

  <!-- Ganti nomor WhatsApp & email di bawah ini dengan kontak resmi -->
  <div class="actions">
    <a class="btn btn-primary" href="https://wa.me/6281299612526" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.71 2-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm0 18.15c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.16.83.84-3.08-.2-.32a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 4.53 0 8.22 3.69 8.22 8.23 0 4.54-3.69 8.23-8.22 8.23z"/></svg>
      Hubungi via WhatsApp
    </a>
    <a class="btn btn-ghost" href="mailto:halo@dekorasi.me">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 7 9 6 9-6"/></svg>
      halo@dekorasi.me
    </a>
  </div>

</main>

<footer>
  &copy; <span id="year">2026</span> Dekorasi.me
  <span class="sep">•</span> Interior Design Studio
</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>

</body>
</html>
